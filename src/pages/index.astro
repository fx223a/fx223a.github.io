---
// ============================================================
// 网站根地址（https://uavdroneengine.com/）：自动跳转到默认语言首页（2026-10-23 起为英语 /en/）。
// 用页面而不用 astro.config.mjs 的 redirects，原因：
//  - 带完整的分享卡片信息（标题 + 简介 + 大图）：在 WhatsApp / Telegram 里直接发域名也能显示正常预览
//   （原来的自动跳转页标题是 “Redirecting to: /ru/”，没有图片）；
//  - 跳转时保留网址里的 ?参数（如广告、社媒链接的来源标记）；location.replace 不留“返回键死循环”；
//  - 深色背景，跳转瞬间不闪白。
// 跳到哪种语言跟随 src/i18n/config.ts 的 defaultLocale，这里不用改。
// ============================================================
import { defaultLocale, locales, localeNames } from '../i18n/config';
import { useTranslations, ogLocale } from '../i18n/utils';

const t = useTranslations(defaultLocale);
const target = `/${defaultLocale}/`;
const site = Astro.site?.origin ?? '';
const title = `${t('site_name')} — ${t('site_tagline')}`;
const description = t('home_hero_subtitle');
// 万一跳转没发生（极少见），页面上给出四种语言的入口，默认语言排最前
const ordered = [defaultLocale, ...locales.filter((l) => l !== defaultLocale)];
---
<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
    <!-- 不开 JS 时的后备跳转（放在 noscript 里，避免和上面的脚本跳转抢先、丢掉网址参数） -->
    <noscript><meta http-equiv="refresh" content={`0;url=${target}`} /></noscript>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${site}${target}`} />
    <meta name="theme-color" content="#07080a" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    {/* 分享卡片：与默认语言首页一致 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site_name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}${target}`} />
    <meta property="og:locale" content={ogLocale[defaultLocale]} />
    <meta property="og:image" content={`${site}/og/default.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og/default.jpg`} />

    <style is:inline>
      html { background: #07080a; color: #f4f5f7; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
      /* 正常情况下页面瞬间跳走，看不到这块；1.5 秒后还没跳走才显示 */
      .fallback { padding: 1.5rem; text-align: center; visibility: hidden; animation: reveal 0s 1.5s forwards; }
      @keyframes reveal { to { visibility: visible; } }
      .fallback p { margin: 0 0 1rem; font-weight: 700; letter-spacing: 0.04em; }
      .fallback ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem 1.5rem; margin: 0; padding: 0; list-style: none; }
      .fallback a { color: #ff7a6b; }
    </style>
  </head>
  <body>
    <main class="fallback">
      <p>{t('site_name')}</p>
      <ul>
        {ordered.map((l) => (
          <li><a href={`/${l}/`} hreflang={l} lang={l}>{localeNames[l]}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
