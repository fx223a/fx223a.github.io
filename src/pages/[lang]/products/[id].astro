<script>
  // ============================================================
  // 详情页交互：画廊切换（按钮 / 缩略图 / 键盘 / 手机滑动）+ 放大查看 + 打印
  // ============================================================
  const galleryEl = document.querySelector<HTMLElement>('[data-gallery]');
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImg = document.querySelector<HTMLImageElement>('[data-lightbox-img]');

  if (galleryEl) {
    const imgs = Array.from(galleryEl.querySelectorAll<HTMLImageElement>('.gallery-img'));
    const thumbs = Array.from(galleryEl.querySelectorAll<HTMLButtonElement>('.thumb'));
    const counter = galleryEl.querySelector<HTMLElement>('[data-gallery-current]');
    let current = Math.max(0, imgs.findIndex((img) => img.classList.contains('is-active')));

    const go = (i: number) => {
      current = (i + imgs.length) % imgs.length;
      imgs.forEach((img, k) => img.classList.toggle('is-active', k === current));
      thumbs.forEach((b, k) => b.setAttribute('aria-pressed', String(k === current)));
      if (counter) counter.textContent = String(current + 1);
    };
    const rtl = document.documentElement.dir === 'rtl';
    galleryEl.querySelector('[data-gallery-prev]')?.addEventListener('click', () => go(current - 1));
    galleryEl.querySelector('[data-gallery-next]')?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((b, k) => b.addEventListener('click', () => go(k)));
    galleryEl.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current + (rtl ? -1 : 1));
      if (e.key === 'ArrowLeft') go(current + (rtl ? 1 : -1));
    });

    // 手机左右滑动切换
    let startX = 0;
    const stage = galleryEl.querySelector<HTMLElement>('.gallery-stage');
    stage?.addEventListener('pointerdown', (e) => (startX = e.clientX));
    stage?.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40) go(current + ((dx < 0) !== rtl ? 1 : -1));
    });

    // 放大查看
    const openLightbox = () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = imgs[current].dataset.full || imgs[current].currentSrc || imgs[current].src; // 放大查看总是用大图
      lightboxImg.alt = imgs[current].alt;
      lightbox.showModal();
    };
    galleryEl.querySelector('[data-gallery-zoom]')?.addEventListener('click', openLightbox);
    imgs.forEach((img) => img.addEventListener('dblclick', openLightbox));
  }

  lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close());
  // 点击图片外的暗色区域也关闭
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  // 打印 / 另存为 PDF
  document.querySelectorAll('[data-print]').forEach((btn) => btn.addEventListener('click', () => window.print()));
</script>

