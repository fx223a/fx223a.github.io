---
// ============================================================
// 产品详情页（多语言）
// 网址：/ru/products/yt-550/ 、/en/products/yt-550/ ……（语言 × 型号 自动生成）
// 内容：
//   1. 画廊（抠图大图 + 缩略图 + 左右切换 + 点击放大）+ 型号信息 + 关键参数 + 询价按钮
//   2. 性能可视化：转速范围 / 海拔推力保持率 / 化油器 vs 电喷油耗 / 在产品线中的功率位置
//   3. 完整参数（按 性能 / 发动机 / 燃油与点火 / 重量与尺寸 / 选件 分组）+ 打印参数单
//   4. 安装尺寸（等轴测线框图 + 长宽高）  5. 其它型号  6. 询价横幅
// ★ 所有数字都直接来自 products.json；百分比是用两项真实参数算出来的，不编造任何数据。
// ============================================================
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Maximize2 from '@lucide/astro/icons/maximize-2';
import X from '@lucide/astro/icons/x';
import Printer from '@lucide/astro/icons/printer';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import PackageCheck from '@lucide/astro/icons/package-check';
import Wrench from '@lucide/astro/icons/wrench';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHead from '../../../components/SectionHead.astro';
import ProductCard from '../../../components/ProductCard.astro';
import CtaBand from '../../../components/CtaBand.astro';
import BrandIcon from '../../../components/BrandIcon.astro';
import Logo from '../../../components/Logo.astro';
import { locales } from '../../../i18n/config';
import { useTranslations, localizeSpecValue, localizeUnit, formatNumber, formatStat } from '../../../i18n/utils';
import { products, metrics, cutout, groupedSpecs, lineupStats, specValue, type Product } from '../../../lib/products';
import { responsive } from '../../../lib/image-size';
import { CONTACT, SALES } from '../../../config/site';

// 为“每种语言 × 每个型号”各生成一个详情页，并把该型号数据通过 props 传进来。
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, id: product.id },
      props: { product },
    }))
  );
}

const { lang } = Astro.params;
const { product } = Astro.props as { product: Product };
const t = useTranslations(lang);
const u = (unit: string) => localizeUnit(unit, lang);
const num = (v: number | null) => (v === null ? '—' : formatNumber(v, lang));
const pct = (v: number) => formatStat(Math.round(v), lang);
const m = metrics(product);
const stats = lineupStats();
const site = Astro.site?.origin ?? '';
const home = `/${lang}/`;

// 参数原文 → 显示文字
const show = (value: string) => (value.startsWith('specval_') ? t(value) : localizeSpecValue(value, lang));

// ---- 一句话介绍：完全由真实参数拼出 ----
const intro =
  t('detail_intro', {
    model: product.model,
    cyl: product.cylinders === 4 ? t('detail_cyl_4') : t('detail_cyl_2'),
    cool: product.cooling === 'water' ? t('detail_cool_water') : t('detail_cool_air'),
    power: `${num(m.kw)} ${u('kW')}`,
    thrust: `${num(m.thrust100)} ${u('kg')}`,
  }) + (m.mtow !== null ? (lang === 'zh' ? '' : ' ') + t('detail_intro_mtow', { mtow: `${num(m.mtow)} ${u('kg')}` }) : '');

// ---- 画廊：主图默认用 -2（product.image）----
// 每张图都有小图（520px）和大图（约 1000px，AI 超分辨率）两个版本，浏览器自动挑选
const gallery = product.images.map((src) => ({
  sm: cutout(src, 'sm'),
  lg: cutout(src),
  r: responsive(cutout(src, 'sm'), cutout(src)),
}));
const mainIndex = Math.max(0, product.images.indexOf(product.image));
const imgAlt = `${product.model} — ${t('product_image_alt')}`;

// ---- WhatsApp 预填消息（打开就是“我想咨询 YT-550CC”）----
const waHref = `https://wa.me/${CONTACT.phoneDigits}?text=${encodeURIComponent(t('wa_prefill', { model: product.model }))}`;

// ---- 性能可视化 ----
// 转速表（半圆 0–8000 rpm）
const RPM_MAX = 8000;
const G = { cx: 160, cy: 150, r: 120 };
const rpmPoint = (rpm: number, r = G.r) => {
  const a = Math.PI + (rpm / RPM_MAX) * Math.PI; // 左(180°) → 右(360°)，经过顶部
  return [G.cx + r * Math.cos(a), G.cy + r * Math.sin(a)];
};
const arcPath = (from: number, to: number, r = G.r) => {
  const [x1, y1] = rpmPoint(from, r);
  const [x2, y2] = rpmPoint(to, r);
  return `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 0 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};
const rpmTicks = Array.from({ length: RPM_MAX / 1000 + 1 }, (_, i) => {
  const [x1, y1] = rpmPoint(i * 1000, G.r - 16);
  const [x2, y2] = rpmPoint(i * 1000, G.r - 8);
  const [lx, ly] = rpmPoint(i * 1000, G.r - 30);
  return { x1, y1, x2, y2, lx, ly, v: i };
});
const idlePoint = m.idle !== null ? rpmPoint(m.idle, G.r) : null;

// 海拔推力保持率 = 1800 米推力 ÷ 100 米推力
const altRatio = m.thrust100 && m.thrust1800 ? m.thrust1800 / m.thrust100 : null;
// 电喷省油比例 = (化油器油耗 − 电喷油耗) ÷ 化油器油耗
const fuelSaving = m.fuelCarb && m.fuelEfi ? (m.fuelCarb - m.fuelEfi) / m.fuelCarb : null;
// 全系功率对比（强调当前型号，其余灰色）
const lineup = products.map((p) => ({ p, kw: metrics(p).kw ?? 0, current: p.id === product.id }));
const kwAxis = 50;

// ---- 参数分组 ----
const groups = groupedSpecs(product);

// ---- 安装尺寸：等轴测线框图（按真实长宽高比例绘制）----
const dims = m.dims;
let iso: null | {
  edges: { d: string; hidden?: boolean }[];
  labels: { x: number; y: number; text: string; anchor: string }[];
  dimLines: string[];
  extLines: string[];
  ends: number[][];
  viewBox: string;
} = null;
if (dims) {
  const [L, W, H] = dims;
  const s = 210 / Math.max(L, W, H); // 最大边缩放到 210 个单位
  const c30 = Math.cos(Math.PI / 6);
  const s30 = Math.sin(Math.PI / 6);
  const P = (x: number, y: number, z: number) => [(x - y) * c30 * s, (x + y) * s30 * s - z * s];
  const pts = {
    a: P(0, 0, 0), b: P(L, 0, 0), c: P(L, W, 0), d: P(0, W, 0),
    e: P(0, 0, H), f: P(L, 0, H), g: P(L, W, H), h: P(0, W, H),
  };
  const xs = Object.values(pts).map((p) => p[0]);
  const ys = Object.values(pts).map((p) => p[1]);
  const pad = 70;
  const minX = Math.min(...xs) - pad;
  const minY = Math.min(...ys) - pad;
  const w = Math.max(...xs) - Math.min(...xs) + pad * 2;
  const h = Math.max(...ys) - Math.min(...ys) + pad * 2;
  const seg = (p: number[], q: number[]) => `M ${p[0].toFixed(1)} ${p[1].toFixed(1)} L ${q[0].toFixed(1)} ${q[1].toFixed(1)}`;
  // 可见棱：顶面 4 条 + 3 条竖棱 + 底面前 2 条；被挡住的 3 条画虚线
  const edges = [
    { d: seg(pts.e, pts.f) }, { d: seg(pts.f, pts.g) }, { d: seg(pts.g, pts.h) }, { d: seg(pts.h, pts.e) },
    { d: seg(pts.b, pts.f) }, { d: seg(pts.c, pts.g) }, { d: seg(pts.d, pts.h) },
    { d: seg(pts.b, pts.c) }, { d: seg(pts.c, pts.d) },
    { d: seg(pts.a, pts.b), hidden: true }, { d: seg(pts.a, pts.d), hidden: true }, { d: seg(pts.a, pts.e), hidden: true },
  ];
  // 尺寸线：沿 b→c（宽）、c→d（长）的外侧，以及 d→h（高）的外侧
  const off = (p: number[], dx: number, dy: number) => [p[0] + dx, p[1] + dy];
  const lenA = off(pts.c, 0, 34);
  const lenB = off(pts.d, 0, 34);
  const widA = off(pts.b, 0, 34);
  const widB = off(pts.c, 0, 34);
  const hgtA = off(pts.d, -34, 0);
  const hgtB = off(pts.h, -34, 0);
  const mid = (p: number[], q: number[]) => [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
  const mm = u('mm');
  iso = {
    edges,
    dimLines: [seg(lenA, lenB), seg(widA, widB), seg(hgtA, hgtB)],
    // 引出线：从箱体棱角连到尺寸线两端（工程图画法）
    extLines: [seg(pts.c, lenA), seg(pts.d, lenB), seg(pts.b, widA), seg(pts.d, hgtA), seg(pts.h, hgtB)],
    ends: [lenA, lenB, widA, widB, hgtA, hgtB],
    labels: [
      { x: mid(lenA, lenB)[0] - 6, y: mid(lenA, lenB)[1] + 22, text: `${t('dims_length')} ${num(L)} ${mm}`, anchor: 'end' },
      { x: mid(widA, widB)[0] + 6, y: mid(widA, widB)[1] + 22, text: `${t('dims_width')} ${num(W)} ${mm}`, anchor: 'start' },
      { x: mid(hgtA, hgtB)[0] - 10, y: mid(hgtA, hgtB)[1], text: `${t('dims_height')} ${num(H)} ${mm}`, anchor: 'end' },
    ],
    viewBox: `${(minX - 60).toFixed(0)} ${minY.toFixed(0)} ${(w + 60).toFixed(0)} ${h.toFixed(0)}`,
  };
}

// ---- 其它型号：排量最接近的 3 款 ----
const related = products
  .filter((p) => p.id !== product.id)
  .sort((a, b) => Math.abs((metrics(a).cc ?? 0) - (m.cc ?? 0)) - Math.abs((metrics(b).cc ?? 0) - (m.cc ?? 0)))
  .slice(0, 3);

// ---- 结构化数据：产品 + 面包屑（不含价格：价格不上网站）----
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.model,
    sku: product.model,
    description: intro,
    image: product.images.map((src) => `${site}${src}`),
    brand: { '@type': 'Brand', name: t('site_name') },
    category: t('product_image_alt'),
    url: `${site}/${lang}/products/${product.id}/`,
    additionalProperty: product.specs.map((s) => ({
      '@type': 'PropertyValue',
      name: t('spec_' + s.key),
      value: show(s.value),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav_home'), item: `${site}${home}` },
      { '@type': 'ListItem', position: 2, name: t('nav_products'), item: `${site}/${lang}/products/` },
      { '@type': 'ListItem', position: 3, name: product.model, item: `${site}/${lang}/products/${product.id}/` },
    ],
  },
];

const keySpecs = [
  { label: t('short_power'), value: num(m.kw), unit: u('kW'), sub: m.hp !== null ? `${num(m.hp)} ${u('hp')}` : null },
  { label: t('short_thrust_100'), value: num(m.thrust100), unit: u('kg'), sub: m.thrust1800 !== null ? `${t('short_thrust_1800')}: ${num(m.thrust1800)} ${u('kg')}` : null },
  { label: t('short_displacement'), value: num(m.cc), unit: u('cc'), sub: specValue(product, 'diameter_stroke') ? show(specValue(product, 'diameter_stroke')!) : null },
  { label: m.weightKey === 'main_machine_weight' ? t('short_weight_main') : t('short_weight'), value: num(m.weight), unit: u('kg'), sub: m.mtow !== null ? `${t('short_mtow')}: ${num(m.mtow)} ${u('kg')}` : null },
];
---
<BaseLayout title={product.model} description={intro} ogImage={`/og/${product.id}.jpg`} jsonLd={jsonLd}>
  <!-- ======================================================
       1. 画廊 + 型号信息
       ====================================================== -->
  <section class="page-hero detail-hero" aria-labelledby="product-title">
    <div class="container">
      <nav class="breadcrumb no-print" aria-label="Breadcrumb">
        <ol>
          <li><a href={home}>{t('nav_home')}</a></li>
          <li><a href={`/${lang}/products/`}>{t('nav_products')}</a></li>
          <li><span aria-current="page">{product.model}</span></li>
        </ol>
      </nav>

      <!-- 打印时才显示的页眉（Logo + 网址） -->
      <div class="print-only print-head">
        <span class="logo"><Logo id="logo-print" /></span>
        <span>uavdroneengine.com</span>
      </div>

      <div class="detail-grid">
        <div class="gallery" data-gallery>
          <div class="gallery-stage">
            <span class="gallery-cc" aria-hidden="true">{m.cc}<small>cc</small></span>
            {gallery.map((g, i) => (
              <img
                class:list={['gallery-img', { 'is-active': i === mainIndex }]}
                src={g.r.src}
                srcset={g.r.srcset}
                sizes="(max-width: 960px) 80vw, 490px"
                data-full={g.lg}
                alt={`${imgAlt} (${i + 1}/${gallery.length})`}
                width={g.r.width}
                height={g.r.height}
                loading={i === mainIndex ? 'eager' : 'lazy'}
                fetchpriority={i === mainIndex ? 'high' : undefined}
                decoding="async"
                data-index={i}
              />
            ))}
            <button class="gallery-nav gallery-prev no-print" type="button" data-gallery-prev aria-label={t('gallery_prev')}>
              <ChevronLeft class="dir-arrow" aria-hidden="true" />
            </button>
            <button class="gallery-nav gallery-next no-print" type="button" data-gallery-next aria-label={t('gallery_next')}>
              <ChevronRight class="dir-arrow" aria-hidden="true" />
            </button>
            <button class="gallery-zoom no-print" type="button" data-gallery-zoom aria-label={t('gallery_zoom')}>
              <Maximize2 aria-hidden="true" />
            </button>
            <span class="gallery-count no-print" aria-hidden="true" dir="ltr"><span data-gallery-current>{mainIndex + 1}</span> / {gallery.length}</span>
          </div>
          <div class="gallery-thumbs no-print" role="group" aria-label={t('gallery_label')}>
            {gallery.map((g, i) => (
              <button class="thumb" type="button" aria-pressed={i === mainIndex ? 'true' : 'false'} data-index={i} aria-label={`${imgAlt} (${i + 1}/${gallery.length})`}>
                <img src={g.sm} alt="" width={g.r.width} height={g.r.height} loading="lazy" decoding="async" />
              </button>
            ))}
          </div>
        </div>

        <div class="detail-info">
          <p class="eyebrow">{product.cylinders === 4 ? t('filter_four') : t('filter_twin')} · {product.cooling === 'water' ? t('filter_water') : t('filter_air')}</p>
          <h1 class="detail-title" id="product-title">{product.model}</h1>
          <p class="detail-intro">{intro}</p>
          <ul class="tag-row detail-tags">
            {product.features.map((f) => <li class="tag">{t('feature_' + f)}</li>)}
          </ul>

          <dl class="key-specs">
            {keySpecs.map((k) => (
              <div>
                <dt>{k.label}</dt>
                <dd>
                  <bdi class="ks-value">{k.value} <small>{k.unit}</small></bdi>
                  {k.sub && <bdi class="ks-sub">{k.sub}</bdi>}
                </dd>
              </div>
            ))}
          </dl>

          <div class="detail-ctas no-print">
            <a class="btn btn--primary btn--lg" href={waHref} target="_blank" rel="noopener">
              <BrandIcon name="whatsapp" />
              {t('detail_cta_whatsapp')}
            </a>
            <a class="btn btn--ghost btn--lg" href={`/${lang}/inquiry/?model=${product.id}`}>{t('nav_inquiry')}</a>
          </div>
          <ul class="trust-list">
            <li><ShieldCheck aria-hidden="true" />{t('detail_trust_warranty')}</li>
            <li><PackageCheck aria-hidden="true" />{t('detail_trust_delivery')}</li>
            <li><Wrench aria-hidden="true" />{t('detail_trust_support')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================
       2. 性能可视化
       ====================================================== -->
  <section class="section section--line perf-section no-print" id="performance" aria-labelledby="perf-title">
    <div class="container">
      <SectionHead eyebrow={t('perf_eyebrow')} title={t('perf_title')} id="perf-title" />
      <div class="perf-grid">
        {m.rpm && (
          <article class="card perf-card" data-reveal style="--i:0">
            <h3>{t('perf_rpm_title')}</h3>
            <svg class="rpm-gauge" viewBox="0 0 320 175" role="img" aria-label={`${t('perf_rpm_title')}: ${num(m.rpm[0])}–${num(m.rpm[1])} ${u('rpm')}`}>
              <path class="rg-track" d={arcPath(0, RPM_MAX)} />
              <path class="rg-range" d={arcPath(m.rpm[0], m.rpm[1])} />
              {rpmTicks.map((k) => (
                <g>
                  <line x1={k.x1.toFixed(1)} y1={k.y1.toFixed(1)} x2={k.x2.toFixed(1)} y2={k.y2.toFixed(1)} />
                  <text x={k.lx.toFixed(1)} y={k.ly.toFixed(1)}>{k.v}</text>
                </g>
              ))}
              {idlePoint && <circle class="rg-idle" cx={idlePoint[0].toFixed(1)} cy={idlePoint[1].toFixed(1)} r="5" />}
              <text class="rg-unit" x={G.cx} y={G.cy - 12}>×1000 {u('rpm')}</text>
            </svg>
            <p class="perf-big"><bdi>{num(m.rpm[0])}–{num(m.rpm[1])}</bdi> <small>{u('rpm')}</small></p>
            {m.idle !== null && <p class="perf-note"><span class="dot dot--idle" aria-hidden="true"></span>{t('perf_rpm_idle', { rpm: `${num(m.idle)} ${u('rpm')}` })}</p>}
          </article>
        )}

        {altRatio !== null && (
          <article class="card perf-card" data-reveal style="--i:1">
            <h3>{t('perf_alt_title')}</h3>
            <div class="hbars">
              <div class="hbar">
                <span class="hbar-label">{t('chart_legend_100')}</span>
                <span class="hbar-track"><span class="hbar-fill hbar-fill--a" style="--w:1"></span></span>
                <bdi class="hbar-val">{num(m.thrust100)} {u('kg')}</bdi>
              </div>
              <div class="hbar">
                <span class="hbar-label">{t('chart_legend_1800')}</span>
                <span class="hbar-track"><span class="hbar-fill hbar-fill--b" style={`--w:${altRatio.toFixed(4)}`}></span></span>
                <bdi class="hbar-val">{num(m.thrust1800)} {u('kg')}</bdi>
              </div>
            </div>
            <p class="perf-big">{pct(altRatio * 100)}<small>%</small></p>
            <p class="perf-note">{t('perf_alt_note', { p: pct(altRatio * 100) })}</p>
          </article>
        )}

        {fuelSaving !== null && (
          <article class="card perf-card" data-reveal style="--i:2">
            <h3>{t('perf_fuel_title')}</h3>
            <div class="hbars">
              <div class="hbar">
                <span class="hbar-label">{t('perf_fuel_carb')}</span>
                <span class="hbar-track"><span class="hbar-fill hbar-fill--muted" style="--w:1"></span></span>
                <bdi class="hbar-val">{num(m.fuelCarb)} {u('L/h')}</bdi>
              </div>
              <div class="hbar">
                <span class="hbar-label">{t('perf_fuel_efi')}</span>
                <span class="hbar-track"><span class="hbar-fill hbar-fill--a" style={`--w:${(1 - fuelSaving).toFixed(4)}`}></span></span>
                <bdi class="hbar-val">{num(m.fuelEfi)} {u('L/h')}</bdi>
              </div>
            </div>
            <p class="perf-big">−{pct(fuelSaving * 100)}<small>%</small></p>
            <p class="perf-note">{t('perf_fuel_note', { p: pct(fuelSaving * 100) })}</p>
          </article>
        )}

        <article class="card perf-card" data-reveal style="--i:3">
          <h3>{t('perf_lineup_title')}</h3>
          <ol class="lineup-bars">
            {lineup.map((l) => (
              <li class:list={{ current: l.current }}>
                <a href={`/${lang}/products/${l.p.id}/`} aria-current={l.current ? 'page' : undefined}>
                  <span class="lb-name">{l.p.model.replace(/^YT-/, '').replace(/CC$/, '')}</span>
                  <span class="lb-track"><span class="lb-fill" style={`--w:${(l.kw / kwAxis).toFixed(4)}`}></span></span>
                  <bdi class="lb-val">{num(l.kw)}</bdi>
                </a>
              </li>
            ))}
          </ol>
          <p class="perf-note">{t('short_power')}, {u('kW')}. {t('perf_lineup_note', { max: `${num(stats.kw[1])} ${u('kW')}` })}</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================
       3. 完整参数（分组）
       ====================================================== -->
  <section class="section section--alt section--line" id="specs" aria-labelledby="specs-title">
    <div class="container">
      <div class="specs-head">
        <SectionHead eyebrow={t('specs_eyebrow')} title={t('specs_title')} id="specs-title" />
        <button class="btn btn--ghost no-print" type="button" data-print>
          <Printer aria-hidden="true" />
          {t('detail_print')}
        </button>
      </div>
      <div class="spec-groups">
        {groups.map((g, i) => (
          <section class="card spec-group" data-reveal style={`--i:${i % 2}`} aria-labelledby={`sg-${g.id}`}>
            <h3 id={`sg-${g.id}`}>{t('specs_group_' + g.id)}</h3>
            <dl class="spec-list">
              {g.specs.map((s) => (
                <div>
                  <dt>{t('spec_' + s.key)}</dt>
                  <dd><bdi>{show(s.value)}</bdi></dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
      </div>
      <p class="specs-note">{t('specs_note')}</p>
    </div>
  </section>

  <!-- ======================================================
