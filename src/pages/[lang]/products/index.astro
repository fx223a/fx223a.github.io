---
// ============================================================
// 产品列表页（多语言）
// 网址：/ru/products/ 、/en/products/（将来启用 fa 会自动多生成 /fa/products/）
// 作用：把 src/data/products.json 里的 7 个型号，用卡片网格列出来。
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import products from '../../../data/products.json';

// 为每一种“已启用语言”各生成一个产品列表页
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// 卡片上重点显示的参数（按此顺序）。某型号若没有这一项，就自动跳过不显示。
// 想调整卡片显示哪些参数，改这个数组即可。
const highlightKeys = [
  'power',               // 功率
  'displacement',        // 排量
  'static_thrust_100m',  // 拉力（海拔 100 米）
  'static_thrust_1800m', // 拉力（海拔 1800 米）—— 高原数据，对俄罗斯/伊朗客户重要
  'max_takeoff_weight',  // 最大起飞重量
  'dimensions',          // 尺寸
];

// 小帮手：在某型号的参数里，按 key 找出对应的数值；找不到返回 null。
function getSpec(product: { specs: { key: string; value: string }[] }, key: string) {
  const found = product.specs.find((s) => s.key === key);
  return found ? found.value : null;
}
---
<BaseLayout title={t('nav_products')}>
  <section>
    <h1>{t('products_title')}</h1>
    <p class="products-intro">{t('products_intro')}</p>

    <!-- 产品卡片网格：每个型号一张卡片 -->
    <div class="product-grid">
      {products.map((product) => (
        <a class="product-card" href={`/${lang}/products/${product.id}/`}>
          <!-- 主图：固定高度容器 + object-fit: contain，保证每张卡图片高度一致、不变形、不裁切。
               alt 文字 = 型号名 + 翻译描述（走 i18n，随语言切换）。loading="lazy" 让图片按需加载。 -->
          <div class="product-photo">
            <img
              src={product.image}
              alt={`${product.model} — ${t('product_image_alt')}`}
              loading="lazy"
            />
          </div>

          <h2 class="product-model">{product.model}</h2>

          <!-- 亮点徽章：冷却方式 + 缸数（文字随语言自动切换）-->
          <div class="badges">
            <span class="badge">
              {product.cooling === 'water' ? t('feature_water_cooled') : t('feature_air_cooled')}
            </span>
            <span class="badge">{product.cylinders} {t('label_cylinders')}</span>
          </div>

          <!-- 重点参数列表：只显示 highlightKeys 里、且该型号存在的项 -->
          <dl class="spec-list">
            {highlightKeys.map((key) => {
              const value = getSpec(product, key);
              return value ? (
                <div class="spec-row">
                  <dt>{t('spec_' + key)}</dt>
                  <dd>{value.startsWith('specval_') ? t(value) : value}</dd>
                </div>
              ) : null;
            })}
          </dl>

          <!-- 查看详情提示（整张卡片可点击进入详情页）-->
          <span class="view-details">{t('view_details')} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  /* 说明：这段样式只作用于本页面（Astro 的 <style> 默认是“局部样式”）。
     方向相关的写法仍用逻辑属性，保证将来波斯语(RTL)下自动镜像。 */

  .products-intro {
    color: #555;
    margin-block: 0 2rem;
  }

  /* 卡片网格：自动按屏幕宽度排列，每张卡片最小 260px，手机上自动换成单列 */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* 整张卡片是一个链接：去掉下划线、文字颜色继承正常色 */
  .product-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    padding: 1.25rem;
    background: #fff;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .product-card:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  /* “查看详情 →”提示：靠近卡片底部，悬停卡片时变红 */
  .view-details {
    display: inline-block;
    margin-block-start: 0.9rem;
    font-size: 0.85rem;
    color: #b91c1c;
    font-weight: 600;
  }

  /* 主图容器：固定高度 180px，图片居中。
     object-fit: contain = 完整显示整台发动机（不裁切），不同宽高的图都统一成同样高度的区域，卡片不会高低不齐。 */
  .product-photo {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    border-radius: 8px;
    padding: 0.5rem;
    margin-block-end: 0.75rem;
  }
  .product-photo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .product-model {
    margin-block: 0 0.75rem;
    font-size: 1.4rem;
    color: #b91c1c;
  }

  /* 徽章行 */
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-end: 1rem;
  }
  .badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: #f3f4f6;
    border-radius: 999px;
    font-size: 0.8rem;
    color: #374151;
  }

  /* 参数列表：改成“标签在上、数值在下”的堆叠式。
     好处：长数值（如尺寸 285 × 220 × 222 mm）不会和标签在同一行互相挤压换行，排版更整齐。 */
  .spec-list {
    margin: 0;
  }
  .spec-row {
    padding-block: 0.4rem;
    border-block-start: 1px solid #f0f0f0;
  }
  .spec-row dt {
    color: #666;
    font-size: 0.78rem;
    margin-block-end: 0.1rem;
  }
  .spec-row dd {
    margin: 0;
    font-weight: 600;
  }
</style>
