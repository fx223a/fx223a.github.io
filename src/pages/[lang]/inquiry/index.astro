---
// ============================================================
// 询价页（多语言）—— WhatsApp 优先（客户 2026-08-08 决定）
// 网址：/ru/inquiry/ 、/en/inquiry/ 、/zh/inquiry/
// 流程：价格不放网站。页面把客户引到 WhatsApp/Telegram 私聊；
//       下面的表单是“消息生成器”：填完后一键打开 WhatsApp，
//       消息内容已按字段预填好，客户点发送即可（无任何后端）。
//  - 无 JS 时表单自动隐藏（hidden，由脚本移除），直连按钮始终可用——
//    绝不会出现“提交了却没人收到”或“数据拼进地址栏”的情况。
//  - 支持从详情页带型号跳转：?model=yt-550 时下拉自动选中。
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import { CONTACT } from '../../../config/site';
import products from '../../../data/products.json';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---
<BaseLayout title={t('inquiry_title')} description={t('inquiry_intro')}>
  <section class="inquiry">
    <h1>{t('inquiry_title')}</h1>
    <p class="inquiry-intro">{t('inquiry_intro')}</p>

    <!-- ===== 直连通道（主入口，无 JS 也可用）===== -->
    <div class="contact-buttons">
      <a class="btn btn-wa" href={CONTACT.whatsappLink} rel="noopener">
        {t('inquiry_whatsapp_cta')}
      </a>
      <a class="btn btn-outline" href={CONTACT.telegramLink} rel="noopener">
        Telegram: {CONTACT.phoneDisplay}
      </a>
      <a class="btn btn-outline" href={`mailto:${CONTACT.email}`}>
        {CONTACT.email}
      </a>
    </div>

    <p class="or-form" id="orForm" hidden>{t('inquiry_or_form')}</p>

    <!-- ===== 询价消息生成器（增强功能，需 JS；无 JS 时整体隐藏）=====
         data-wa-number 提供纯数字号码给脚本拼 wa.me 链接；
         提交时把各字段拼成一条结构化消息，打开 WhatsApp 预填好，客户按一下发送即可。 -->
    <form
      id="inquiryForm"
      class="inquiry-form"
      hidden
      data-wa-number={CONTACT.phoneDigits}
      data-msg-opened={t('form_whatsapp_opened')}
    >
      <div class="field">
        <label for="name">{t('form_name')}</label>
        <input type="text" id="name" name="name" autocomplete="name" maxlength="100" />
      </div>

      <div class="field">
        <label for="company">{t('form_company')}</label>
        <input type="text" id="company" name="company" autocomplete="organization" maxlength="200" />
      </div>

      <div class="field">
        <label for="model">{t('form_model')}</label>
        <!-- 型号选项由 products.json 自动生成：value 用型号 id，显示用型号名 -->
        <select id="model" name="model">
          <option value="">{t('form_model_placeholder')}</option>
          {products.map((p) => (
            <option value={p.id} data-model-name={p.model}>{p.model}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="quantity">{t('form_quantity')}</label>
        <input type="number" id="quantity" name="quantity" min="1" step="1" />
      </div>

      <div class="field field-full">
        <label for="message">{t('form_message')}</label>
        <textarea id="message" name="message" rows="4" maxlength="1500"></textarea>
      </div>

      <button type="submit" class="btn btn-wa">{t('form_submit_whatsapp')}</button>
    </form>

    <!-- 打开 WhatsApp 后的提示（role=status：读屏软件自动朗读） -->
    <p id="waOpened" class="wa-opened" role="status" aria-live="polite" hidden></p>
  </section>
</BaseLayout>

<script>
  // 有 JS 才显示表单（无 JS 用户直接用上方的直连按钮，不会遇到“提交了没人收到”）
  const form = document.getElementById('inquiryForm') as HTMLFormElement | null;
  const orForm = document.getElementById('orForm');
  if (form) form.hidden = false;
  if (orForm) orForm.hidden = false;

  // 若网址带 ?model=xxx（从详情页“询价”按钮跳来），自动选中对应型号
  const params = new URLSearchParams(window.location.search);
  const wanted = params.get('model');
  const select = document.getElementById('model') as HTMLSelectElement | null;
  if (select && wanted) {
    const opt = Array.from(select.options).find((o) => o.value === wanted);
    if (opt) select.value = wanted;
  }

  // 提交 = 把字段拼成一条消息，打开 WhatsApp（wa.me 预填文本）
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const lines: string[] = ['[Inquiry]'];
    // 逐字段收集：用页面上的 label 文字做前缀（自动跟随当前语言）
    form.querySelectorAll<HTMLElement>('.field').forEach((field) => {
      const label = field.querySelector('label')?.textContent?.trim() ?? '';
      const input = field.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
      if (!input || !input.value) return;
      // 型号下拉显示型号名而不是 id
      const value = input instanceof HTMLSelectElement
        ? (input.selectedOptions[0]?.dataset.modelName ?? input.value)
        : input.value;
      lines.push(`${label}: ${value}`);
    });
    const text = encodeURIComponent(lines.join('\n'));
    const waUrl = `https://wa.me/${form.dataset.waNumber}?text=${text}`;
    // 新标签打开 WhatsApp；本页显示提示（含兜底指引）
    window.open(waUrl, '_blank', 'noopener');
    const opened = document.getElementById('waOpened');
    if (opened) {
      opened.textContent = form.dataset.msgOpened ?? '';
      opened.hidden = false;
    }
  });
</script>

<style>
  /* 方向相关一律用逻辑属性，保证将来波斯语(RTL)自动镜像。 */
  .inquiry-intro {
    color: #555;
    margin-block: 0 1.5rem;
    max-width: 640px;
  }

  /* 直连按钮组：WhatsApp 绿色主按钮 + Telegram/邮箱描边按钮 */
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  .contact-buttons .btn {
    margin-block-start: 0;
  }
  .btn-wa {
    background: #25d366;   /* WhatsApp 品牌绿 */
    color: #fff;
  }
  .btn-wa:hover {
    background: #1faa52;
  }
  .btn-outline {
    background: transparent;
    color: #b91c1c;
    border: 1px solid #b91c1c;
  }
  .btn-outline:hover {
    background: #fef2f2;
  }

  .or-form {
    color: #555;
    margin-block: 0 1rem;
    max-width: 640px;
  }

  /* 两列栅格；窄屏自动单列。留言框跨满整行。 */
  .inquiry-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    max-width: 640px;
  }
  @media (max-width: 560px) {
    .inquiry-form { grid-template-columns: 1fr; }
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .field-full {
    grid-column: 1 / -1;
  }
  .field label {
    font-size: 0.85rem;
    color: #444;
    margin-block-end: 0.3rem;
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.55rem 0.65rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid #b91c1c;
    outline-offset: 1px;
    border-color: #b91c1c;
  }
  .field textarea {
    resize: vertical;
  }

  .inquiry-form .btn {
    grid-column: 1 / -1;
    justify-self: start;
    border: none;
    cursor: pointer;
    margin-block-start: 0.25rem;
  }

  .wa-opened {
    margin-block-start: 1rem;
    padding: 1rem 1.25rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    color: #065f46;
    max-width: 640px;
  }
</style>
