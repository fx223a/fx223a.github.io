---
// ============================================================
// 询价表单页（多语言）
// 网址：/ru/inquiry/ 、/en/inquiry/ 、/zh/inquiry/
// 字段：姓名、公司、邮箱、电话、感兴趣的型号(下拉，自动来自 products.json)、数量、留言
// 说明：
//  - 所有标签与提示走 i18n，随语言切换。
//  - 表单 POST 到 INQUIRY_ENDPOINT（src/config/site.ts，接口部署后填入）。
//    有 JS 时用 fetch 提交，页面内显示 提交中/成功/失败 三态；
//    无 JS 时浏览器原生 POST 到接口，接口返回 303 跳到本目录的 success 页。
//  - 防垃圾：蜜罐字段(website) + 时间戳(ts)，由接口侧校验。
//  - 支持从详情页带型号跳转：网址带 ?model=zt-t550 时，下拉会自动选中该型号。
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';
import { INQUIRY_ENDPOINT } from '../../../config/site';
import products from '../../../data/products.json';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// 无 JS 提交成功后，接口把用户 303 跳回到这个成功页（相对路径，接口侧拼绝对地址）
const successPath = `/${lang}/inquiry/success/`;
---
<BaseLayout title={t('inquiry_title')} description={t('inquiry_intro')}>
  <section class="inquiry">
    <h1>{t('inquiry_title')}</h1>
    <p class="inquiry-intro">{t('inquiry_intro')}</p>

    <!-- 提交结果提示区：
         role="status" + aria-live 让屏幕阅读器自动朗读内容变化；
         tabindex="-1" 让脚本能把焦点移过来（视觉+读屏用户都能立即注意到）。 -->
    <p id="formStatus" class="form-success" role="status" aria-live="polite" tabindex="-1" hidden></p>
    <p id="formError" class="form-error" role="alert" tabindex="-1" hidden></p>

    <!-- method="POST"：即使 JS 加载失败，浏览器原生提交也不会把客户资料拼进地址栏
         （之前既无 action 也无 method，JS 一失效就会 GET 提交泄露姓名邮箱到 URL——已修复）。
         data-msg-* 属性把 i18n 文案带给下方脚本用（脚本拿不到 frontmatter 变量）。 -->
    <form
      id="inquiryForm"
      class="inquiry-form"
      method="POST"
      action={INQUIRY_ENDPOINT || undefined}
      data-msg-sending={t('form_sending')}
      data-msg-success={t('form_success')}
      data-msg-error={t('form_error')}
      data-msg-network={t('form_error_network')}
    >
      <p class="required-hint field-full">{t('form_required_hint')}</p>

      <!-- 隐藏字段：语言（接口回信/通知用）+ 成功页地址（无 JS 时接口 303 跳转用） -->
      <input type="hidden" name="lang" value={lang} />
      <input type="hidden" name="redirect" value={successPath} />
      <!-- 时间戳：页面加载时由脚本填入，接口用它识别“秒填秒交”的机器人 -->
      <input type="hidden" name="ts" id="ts" value="" />

      <!-- 蜜罐字段（防垃圾）：真人看不到也不会填；机器人会盲目填上，接口发现非空即丢弃。
           用 CSS 移出屏幕而不是 display:none / hidden（聪明的机器人会跳过隐藏字段）。 -->
      <div class="hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="name">{t('form_name')} *</label>
        <input type="text" id="name" name="name" required autocomplete="name" maxlength="100" />
      </div>

      <div class="field">
        <label for="company">{t('form_company')}</label>
        <input type="text" id="company" name="company" autocomplete="organization" maxlength="200" />
      </div>

      <div class="field">
        <label for="email">{t('form_email')} *</label>
        <input type="email" id="email" name="email" required autocomplete="email" maxlength="200" />
      </div>

      <div class="field">
        <label for="phone">{t('form_phone')}</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="50" />
      </div>

      <div class="field">
        <label for="model">{t('form_model')}</label>
        <!-- 型号选项由 products.json 自动生成：value 用型号 id，显示用型号名 -->
        <select id="model" name="model">
          <option value="">{t('form_model_placeholder')}</option>
          {products.map((p) => (
            <option value={p.id}>{p.model}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="quantity">{t('form_quantity')}</label>
        <input type="number" id="quantity" name="quantity" min="1" step="1" />
      </div>

      <div class="field field-full">
        <label for="message">{t('form_message')}</label>
        <textarea id="message" name="message" rows="4" maxlength="2000"></textarea>
      </div>

      <button type="submit" class="btn" id="submitBtn">{t('form_submit')}</button>
      <p class="privacy-note field-full">{t('form_privacy_note')}</p>
    </form>
  </section>
</BaseLayout>

<script>
  // 1) 若网址带 ?model=xxx（从详情页“询价”按钮跳来），自动选中对应型号。
  const params = new URLSearchParams(window.location.search);
  const wanted = params.get('model');
  const select = document.getElementById('model') as HTMLSelectElement | null;
  if (select && wanted) {
    const opt = Array.from(select.options).find((o) => o.value === wanted);
    if (opt) select.value = wanted;
  }

  // 2) 填入页面加载时间戳（接口用来识别“秒填秒交”的机器人）
  const tsInput = document.getElementById('ts') as HTMLInputElement | null;
  if (tsInput) tsInput.value = String(Date.now());

  // 3) 真实提交：fetch POST 到接口，三态 UI（提交中/成功/失败）。
  const form = document.getElementById('inquiryForm') as HTMLFormElement | null;
  const statusEl = document.getElementById('formStatus') as HTMLElement | null;
  const errorEl = document.getElementById('formError') as HTMLElement | null;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement | null;
  const btnIdleText = btn?.textContent ?? '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    // 隐藏上一次的提示
    if (statusEl) statusEl.hidden = true;
    if (errorEl) errorEl.hidden = true;

    // 提交中：按钮禁用 + 文案变“发送中…”，防止重复点击
    if (btn) {
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.textContent = form.dataset.msgSending ?? '…';
    }

    const showError = (msg: string) => {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.hidden = false;
        errorEl.focus(); // 把焦点移到提示上：读屏立即朗读，视觉用户也会注意到
      }
    };

    try {
      const action = form.getAttribute('action');
      if (!action) {
        // 接口地址还没配置（INQUIRY_ENDPOINT 为空）：如实报错，绝不假装成功
        showError(form.dataset.msgError ?? 'Error');
        return;
      }
      const res = await fetch(action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) {
        showError(form.dataset.msgError ?? 'Error');
        return;
      }
      // 成功：清空表单（数据已送达），显示成功提示并把焦点移过去
      form.reset();
      if (tsInput) tsInput.value = String(Date.now()); // 重置时间戳，便于再次提交
      if (statusEl) {
        statusEl.textContent = form.dataset.msgSuccess ?? 'OK';
        statusEl.hidden = false;
        statusEl.focus();
      }
    } catch {
      // 网络层失败（断网/被墙/超时）：提示网络错误，保留用户已填内容以便重试
      showError(form.dataset.msgNetwork ?? form.dataset.msgError ?? 'Error');
    } finally {
      // 无论成败都要恢复按钮，否则失败后用户没法重试
      if (btn) {
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        btn.textContent = btnIdleText;
      }
    }
  });
</script>

<style>
  /* 方向相关一律用逻辑属性，保证将来波斯语(RTL)自动镜像。 */
  .inquiry-intro {
    color: #555;
    margin-block: 0 1.5rem;
  }

  /* 两列栅格；窄屏自动单列。留言框跨满整行。 */
  .inquiry-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
    max-width: 640px;
  }
  @media (max-width: 560px) {
    .inquiry-form { grid-template-columns: 1fr; }
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .field-full {
    grid-column: 1 / -1;   /* 跨满整行 */
  }
  .required-hint {
    margin: 0;
    font-size: 0.8rem;
    color: #666;
  }
  .privacy-note {
    margin: 0;
    font-size: 0.8rem;
    color: #888;
  }
  .field label {
    font-size: 0.85rem;
    color: #444;
    margin-block-end: 0.3rem;
  }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    padding: 0.55rem 0.65rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    background: #fff;
    color: #1a1a1a;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: 2px solid #b91c1c;
    outline-offset: 1px;
    border-color: #b91c1c;
  }
  .field textarea {
    resize: vertical;
  }

  /* 蜜罐字段：移出可视区域（不能用 display:none，机器人会跳过隐藏字段） */
  .hp-field {
    position: absolute;
    inset-inline-start: -9999px;
    inset-block-start: auto;
  }

  /* 提交按钮复用全局 .btn 的红色样式；这里让它跨行并靠起始端对齐 */
  .inquiry-form .btn {
    grid-column: 1 / -1;
    justify-self: start;
    border: none;
    cursor: pointer;
    margin-block-start: 0.25rem;
  }
  .inquiry-form .btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .form-success {
    padding: 1rem 1.25rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    color: #065f46;
    max-width: 640px;
  }
  .form-error {
    padding: 1rem 1.25rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 8px;
    color: #991b1b;
    max-width: 640px;
  }
  /* 提示块获得焦点时不需要焦点环（它不是交互元素，焦点只为读屏与滚动定位） */
  .form-success:focus,
  .form-error:focus {
    outline: none;
  }
</style>
