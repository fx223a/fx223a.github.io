---
// ============================================================
// 询价提交成功页（多语言）
// 网址：/ru/inquiry/success/ 、/en/inquiry/success/ 、/zh/inquiry/success/
// 用途：浏览器禁用/加载不了 JS 时，表单会原生 POST 到接口，
//       接口处理完用 303 跳转到本页，让用户明确看到“已发送成功”。
//（有 JS 时提交结果就地显示在表单页，不会来这里。）
// ============================================================
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);
---
<BaseLayout title={t('inquiry_success_title')}>
  <section class="success">
    <h1>{t('inquiry_success_title')}</h1>
    <p class="success-body">{t('inquiry_success_body')}</p>
    <a class="btn" href={`/${lang}/`}>{t('inquiry_success_back')}</a>
  </section>
</BaseLayout>

<style>
  .success {
    max-width: 640px;
    padding-block: 2rem;
  }
  .success-body {
    padding: 1rem 1.25rem;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    border-radius: 8px;
    color: #065f46;
  }
</style>
