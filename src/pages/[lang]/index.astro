---
// ============================================================
// 首页（多语言）
// 结构：Hero → 主力型号展示 → 为什么选择我们 → 关于我们 → 服务与保障 → 询价引导。
// 全部为真实内容（客户 2026-08-08 提供）；工厂/资质/应用/案例四个板块等资料齐了再加回。
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales } from '../../i18n/config';
import { useTranslations, localizeSpecValue } from '../../i18n/utils';
import products from '../../data/products.json';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);

// 【首页主推型号】默认取入门/中端/顶配三款代表整条产品线。
// 想换主推型号，改这个 id 列表即可（对应 CONTENT-TODO I1，待客户确认）。
const featuredIds = ['yt-120', 'yt-350', 'yt-730'];
const featured = featuredIds
  .map((id) => products.find((p) => p.id === id))
  .filter(Boolean) as typeof products;

// 小帮手：按 key 取某型号的参数值（数值经单位本地化，俄语显示 л.с./см³ 等）
function getSpec(product: { specs: { key: string; value: string }[] }, key: string) {
  const found = product.specs.find((s) => s.key === key);
  return found ? localizeSpecValue(found.value, lang) : null;
}
---
<BaseLayout title={t('nav_home')}>
  <!-- ===== Hero ===== -->
  <section class="hero">
    <h1>{t('home_hero_title')}</h1>
    <p>{t('home_hero_subtitle')}</p>
    <a class="btn" href={`/${lang}/products/`}>{t('home_hero_cta')}</a>
  </section>

  <!-- ===== 主力型号展示 ===== -->
  <section class="home-section">
    <h2>{t('home_featured_title')}</h2>
    <p class="section-sub">{t('home_featured_subtitle')}</p>

    <div class="featured-grid">
      {featured.map((product) => (
        <a class="featured-card" href={`/${lang}/products/${product.id}/`}>
          <div class="featured-photo">
            {/* 主推卡片在首屏内：eager 立即加载（lazy 会拖慢首屏 LCP） */}
            <img src={product.image} alt={`${product.model} — ${t('product_image_alt')}`} loading="eager" decoding="async" />
          </div>
          <h3>{product.model}</h3>
          <dl class="featured-specs">
            <div><dt>{t('spec_power')}</dt><dd>{getSpec(product, 'power')}</dd></div>
            <div><dt>{t('spec_displacement')}</dt><dd>{getSpec(product, 'displacement')}</dd></div>
            <div><dt>{t('spec_static_thrust_100m')}</dt><dd>{getSpec(product, 'static_thrust_100m')}</dd></div>
          </dl>
        </a>
      ))}
    </div>

    <!-- 箭头字符是有方向的，RTL（波斯语）下需要镜像；.dir-arrow 的翻转规则在 global.css -->
    <a class="btn btn-outline" href={`/${lang}/products/`}>{t('home_view_all')} <span class="dir-arrow" aria-hidden="true">→</span></a>
  </section>

  <!-- ===== 为什么选择我们（真实产品优势，非占位）===== -->
  <section class="home-section">
    <h2>{t('home_why_title')}</h2>
    <div class="strength-grid">
      <div class="strength">
        <h3>{t('home_strength_range_title')}</h3>
        <p>{t('home_strength_range_text')}</p>
      </div>
      <div class="strength">
        <h3>{t('home_strength_config_title')}</h3>
        <p>{t('home_strength_config_text')}</p>
      </div>
      <div class="strength">
        <h3>{t('home_strength_fuel_title')}</h3>
        <p>{t('home_strength_fuel_text')}</p>
      </div>
    </div>
  </section>

  <!-- ===== 关于我们（真实内容，客户 2026-08-08 提供）===== -->
  <section class="home-section">
    <h2>{t('home_about_title')}</h2>
    <p class="about-text">{t('home_about_text')}</p>
  </section>

  <!-- ===== 服务与保障（真实内容，来自客户报价单，价格已剔除）===== -->
  <section class="home-section">
    <h2>{t('home_service_title')}</h2>
    <div class="strength-grid">
      <div class="strength">
        <h3>{t('home_service_warranty_title')}</h3>
        <p>{t('home_service_warranty_text')}</p>
      </div>
      <div class="strength">
        <h3>{t('home_service_delivery_title')}</h3>
        <p>{t('home_service_delivery_text')}</p>
      </div>
      <div class="strength">
        <h3>{t('home_service_support_title')}</h3>
        <p>{t('home_service_support_text')}</p>
      </div>
      <div class="strength">
        <h3>{t('home_service_custom_title')}</h3>
        <p>{t('home_service_custom_text')}</p>
      </div>
    </div>
  </section>

  <!-- 工厂与产能 / 质量与资质 / 应用场景 / 客户案例 四个板块：
       客户 2026-08-08 决定先删掉尽快上线，资料齐了再加回（i18n 标题 key 都还在）。 -->

  <!-- ===== 询价引导 ===== -->
  <section class="home-section home-cta">
    <h2>{t('home_contact_title')}</h2>
    <p class="section-sub">{t('home_contact_text')}</p>
    <a class="btn" href={`/${lang}/inquiry/`}>{t('nav_inquiry')}</a>
  </section>
</BaseLayout>

<style>
  /* 方向相关一律用逻辑属性，保证将来波斯语(RTL)自动镜像。 */
  .home-section {
    padding-block: 2.5rem;
    border-block-start: 1px solid #eee;
  }
  .home-section > h2 {
    margin-block: 0 0.5rem;
  }
  .section-sub {
    color: #555;
    margin-block: 0 1.5rem;
  }

  .about-text {
    max-width: 720px;
    color: #333;
    margin: 0;
  }

  /* ===== 主力型号卡片 ===== */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    margin-block-end: 1.5rem;
  }
  .featured-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    padding: 1rem;
    background: #fff;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .featured-card:hover {
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }
  .featured-photo {
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    border-radius: 8px;
    padding: 0.5rem;
    margin-block-end: 0.75rem;
  }
  .featured-photo img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }
  .featured-card h3 {
    margin-block: 0 0.6rem;
    color: #b91c1c;
  }
  .featured-specs {
    margin: 0;
  }
  .featured-specs > div {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding-block: 0.25rem;
    border-block-start: 1px solid #f0f0f0;
    font-size: 0.9rem;
  }
  .featured-specs dt { color: #666; }
  .featured-specs dd { margin: 0; font-weight: 600; text-align: end; }

  /* ===== 优势卡片 ===== */
  .strength-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .strength {
    padding: 1.1rem;
    background: #fafafa;
    border-radius: 10px;
  }
  .strength h3 {
    margin-block: 0 0.4rem;
    font-size: 1.05rem;
  }
  .strength p {
    margin: 0;
    color: #444;
  }

  /* ===== 次要按钮（描边）===== */
  .btn-outline {
    background: transparent;
    color: #b91c1c;
    border: 1px solid #b91c1c;
  }
  .btn-outline:hover {
    background: #fef2f2;
  }

  .home-cta {
    text-align: start;
  }
</style>
