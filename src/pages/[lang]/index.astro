---
// ============================================================
// 首页（多语言）
// 结构：
//   1. 大图区：发动机“仪表盘”展台（转速表圆环高亮该型号真实转速范围 + 型号切换 + 参数数字动画）
//   2. 滚动卖点条
//   3. 产品线（7 张产品卡片）
//   4. 全系性能对比图（静推力 / 功率 / 最大起飞重量，可切换；附表格视图）
//   5. 为什么选择我们（6 项，全部来自真实参数）
//   6. 关于我们（客户提供的真实简介 + 大数字 + 三条要点）
//   7. 服务与保障   8. 下单流程   9. 常见问题   10. 询价横幅
// ★ 全部为真实内容：数字都来自客户提供的资料或 products.json，绝不编造。
//   工厂/资质/应用/案例四个板块等客户资料齐了再加回（i18n 标题 key 都还在）。
// ============================================================
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Gauge from '@lucide/astro/icons/gauge';
import Layers from '@lucide/astro/icons/layers';
import Fuel from '@lucide/astro/icons/fuel';
import Mountain from '@lucide/astro/icons/mountain';
import ArrowLeftRight from '@lucide/astro/icons/arrow-left-right';
import Fan from '@lucide/astro/icons/fan';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Truck from '@lucide/astro/icons/truck';
import Wrench from '@lucide/astro/icons/wrench';
import Settings2 from '@lucide/astro/icons/settings-2';
import Plus from '@lucide/astro/icons/plus';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import ProductCard from '../../components/ProductCard.astro';
import Ticker from '../../components/Ticker.astro';
import CtaBand from '../../components/CtaBand.astro';
import BrandIcon from '../../components/BrandIcon.astro';
import { locales } from '../../i18n/config';
import { useTranslations, formatNumber, formatStat, localizeUnit, numberLocaleOf } from '../../i18n/utils';
import { products, metrics, cutout, shortModel } from '../../lib/products';
import { responsive } from '../../lib/image-size';
import { CONTACT } from '../../config/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang);
const u = (unit: string) => localizeUnit(unit, lang);
const num = (v: number | null) => (v === null ? '—' : formatNumber(v, lang));

// ------------------------------------------------------------
// 1) 展台数据：每个型号的关键参数（全部来自 products.json）
// ------------------------------------------------------------
const DEFAULT_ID = 'yt-730'; // 打开页面时先展示旗舰型号
// 展台里发动机图的显示宽度（告诉浏览器该挑小图还是大图）
const STAGE_SIZES = '(max-width: 1080px) 62vw, 360px';
const stage = products.map((p) => {
  const m = metrics(p);
  // 小图 + 大图（视网膜屏自动用大图）
  return { p, m, img: responsive(cutout(p.image, 'sm'), cutout(p.image)) };
});
const active = stage.find((s) => s.p.id === DEFAULT_ID) ?? stage[0];

// 转速表几何：0–8000 rpm 映射到 270° 圆弧（左下 → 顶部 → 右下）
const RPM_MAX = 8000;
const C = 300; // 圆心
const RING = 272; // 量程圆弧半径
const START = 135; // 起始角（度）
const SWEEP = 270; // 总角度
const rad = (deg: number) => (deg * Math.PI) / 180;
const rpmDeg = (rpm: number) => (rpm / RPM_MAX) * SWEEP; // 相对起点的角度
const polar = (rpm: number, r: number) => {
  const a = rad(START + rpmDeg(rpm));
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
const ticks: { x1: number; y1: number; x2: number; y2: number; major: boolean }[] = [];
for (let rpm = 0; rpm <= RPM_MAX; rpm += 250) {
  const major = rpm % 1000 === 0;
  const [x1, y1] = polar(rpm, RING - 14 - (major ? 14 : 6));
  const [x2, y2] = polar(rpm, RING - 14);
  ticks.push({ x1, y1, x2, y2, major });
}
const tickLabels = Array.from({ length: RPM_MAX / 1000 + 1 }, (_, i) => {
  const [x, y] = polar(i * 1000, RING - 52);
  return { x, y, v: i };
});
const rpmArc = (rpm: [number, number] | null) => {
  const [lo, hi] = rpm ?? [0, 0];
  return { a: rpmDeg(lo), b: rpmDeg(hi) };
};
const activeArc = rpmArc(active.m.rpm);
const rpmText = (rpm: [number, number] | null) => (rpm ? `${num(rpm[0])}–${num(rpm[1])}` : '—');
const weightLabel = (m: (typeof stage)[number]['m']) => (m.weightKey === 'main_machine_weight' ? t('short_weight_main') : t('short_weight'));

// ------------------------------------------------------------
// 2) 性能对比图：坐标轴取略大于最大值的整数，保证条形比例诚实
// ------------------------------------------------------------
const axes: Record<'thrust' | 'power' | 'mtow', number[]> = {
  thrust: [0, 20, 40, 60, 80],
  power: [0, 10, 20, 30, 40, 50],
  mtow: [0, 50, 100, 150, 200, 250, 300],
};
const axisMax = (k: keyof typeof axes) => axes[k][axes[k].length - 1];
const chartRows = products.map((p) => {
  const m = metrics(p);
  return {
    p,
    m,
    thrustA: (m.thrust100 ?? 0) / axisMax('thrust'),
    thrustB: (m.thrust1800 ?? 0) / axisMax('thrust'),
    power: (m.kw ?? 0) / axisMax('power'),
    mtow: (m.mtow ?? 0) / axisMax('mtow'),
  };
});
const axisUnit = { thrust: u('kg'), power: u('kW'), mtow: u('kg') };

// ------------------------------------------------------------
// 3) 其它板块的数据
// ------------------------------------------------------------
const strengths = [
  { icon: Gauge, title: 'home_strength_range_title', text: 'home_strength_range_text' },
  { icon: Layers, title: 'home_strength_config_title', text: 'home_strength_config_text' },
  { icon: Fuel, title: 'home_strength_fuel_title', text: 'home_strength_fuel_text' },
  { icon: Mountain, title: 'home_strength_altitude_title', text: 'home_strength_altitude_text' },
  { icon: ArrowLeftRight, title: 'home_strength_mount_title', text: 'home_strength_mount_text' },
  { icon: Fan, title: 'home_strength_prop_title', text: 'home_strength_prop_text' },
];
const services = [
  { icon: ShieldCheck, title: 'home_service_warranty_title', text: 'home_service_warranty_text' },
  { icon: Truck, title: 'home_service_delivery_title', text: 'home_service_delivery_text' },
  { icon: Wrench, title: 'home_service_support_title', text: 'home_service_support_text' },
  { icon: Settings2, title: 'home_service_custom_title', text: 'home_service_custom_text' },
];
const steps = [1, 2, 3, 4, 5];
const faqs = [1, 2, 3, 4, 5, 6, 7, 8];

// 常见问题的结构化数据（问答都在页面上可见）
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((n) => ({
    '@type': 'Question',
    name: t(`faq_${n}_q`),
    acceptedAnswer: { '@type': 'Answer', text: t(`faq_${n}_a`) },
  })),
};
---
<BaseLayout jsonLd={[faqLd]}>
  <!-- ======================================================
       1. 大图区：文案 + 发动机“仪表盘”展台
       ====================================================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow--a"></div>
      <div class="hero-glow hero-glow--b"></div>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{t('hero_eyebrow')}</p>
        <h1 class="hero-title" id="hero-title" data-reveal style="--i:1">
          <span class="text-steel">{t('hero_title_a')}</span>{' '}
          <span class="text-accent">{t('hero_title_b')}</span>
        </h1>
        <p class="hero-lead" data-reveal style="--i:2">{t('home_hero_subtitle')}</p>
        <div class="hero-ctas" data-reveal style="--i:3">
          <a class="btn btn--primary btn--lg" href={`/${lang}/products/`}>
            {t('home_hero_cta')}
            <ArrowRight class="icon-dir" aria-hidden="true" />
          </a>
          <a class="btn btn--ghost btn--lg" href={CONTACT.whatsappLink} target="_blank" rel="noopener">
            <BrandIcon name="whatsapp" />
            {t('cta_chat_whatsapp')}
          </a>
        </div>
        <!-- 真实数字（客户 2026-08-08 提供）：十年经验 / 6 万台+ / 7 款 / 质保 12 个月 -->
        <dl class="hero-stats" data-reveal style="--i:4">
          <div>
            <dt>{t('hero_stat_years')}</dt>
            <dd>{formatStat(10, lang)}</dd>
          </div>
          <div>
            <dt>{t('hero_stat_units')}</dt>
            <dd>{formatStat(60000, lang)}<span>+</span></dd>
          </div>
          <div>
            <dt>{t('hero_stat_models')}</dt>
            <dd>{formatStat(products.length, lang)}</dd>
          </div>
          <div>
            <dt>{t('hero_stat_warranty')}</dt>
            <dd>{formatStat(12, lang)}</dd>
          </div>
        </dl>
      </div>

      <!-- 发动机展台：数据全部写在按钮的 data-* 上，脚本切换时读取 -->
      <div class="hero-stage" data-stage data-locale={numberLocaleOf(lang)} role="region" aria-label={t('stage_label')} data-reveal style="--i:2">
        <div class="stage-head">
          <div>
            <p class="stage-model" data-read="model" aria-live="polite">{active.p.model}</p>
            <p class="stage-tags">
              <span data-read="cyl">{active.p.cylinders === 4 ? t('filter_four') : t('filter_twin')}</span>
              <span aria-hidden="true">·</span>
              <span data-read="cool">{active.p.cooling === 'water' ? t('filter_water') : t('filter_air')}</span>
            </p>
          </div>
          <a class="link-arrow stage-link" data-read="href" href={`/${lang}/products/${active.p.id}/`}>
            {t('stage_view')}
            <ArrowRight aria-hidden="true" />
          </a>
        </div>

        <div class="stage-visual">
          <svg class="stage-gauge" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="gauge-grad" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#e3171c" />
                <stop offset="0.6" stop-color="#ff4b3a" />
                <stop offset="1" stop-color="#ff9a4a" />
              </linearGradient>
              <radialGradient id="gauge-disc">
                <stop offset="0" stop-color="#ffffff" stop-opacity="0.07" />
                <stop offset="0.7" stop-color="#ffffff" stop-opacity="0.015" />
                <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
              </radialGradient>
            </defs>
            <circle cx={C} cy={C} r="246" fill="url(#gauge-disc)" />
            <circle class="g-inner" cx={C} cy={C} r="196" />
            <circle class="g-inner g-inner--2" cx={C} cy={C} r="128" />
            <circle class="g-track" cx={C} cy={C} r={RING} pathLength="360" transform={`rotate(${START} ${C} ${C})`} />
            <circle
              class="g-range"
              data-gauge-range
              cx={C}
              cy={C}
              r={RING}
              pathLength="360"
              transform={`rotate(${START} ${C} ${C})`}
              style={`stroke-dasharray: ${activeArc.b - activeArc.a} 360; stroke-dashoffset: ${-activeArc.a}`}
            />
            <g class="g-ticks">
              {ticks.map((k) => (
                <line class:list={{ major: k.major }} x1={k.x1.toFixed(1)} y1={k.y1.toFixed(1)} x2={k.x2.toFixed(1)} y2={k.y2.toFixed(1)} />
              ))}
            </g>
            <g class="g-labels">
              {tickLabels.map((l) => (
                <text x={l.x.toFixed(1)} y={l.y.toFixed(1)}>{l.v}</text>
              ))}
            </g>
            <g class="g-marker" data-gauge-marker style={`transform: rotate(${START + activeArc.b}deg)`}>
              <circle cx={C + RING} cy={C} r="11" class="g-marker-halo" />
              <circle cx={C + RING} cy={C} r="5.5" class="g-marker-dot" />
            </g>
          </svg>

          <div class="stage-engines">
            {stage.map((s) =>
              s === active ? (
                <img class="stage-engine is-active" data-engine={s.p.id} src={s.img.src} srcset={s.img.srcset} sizes={STAGE_SIZES} alt={`${s.p.model} — ${t('product_image_alt')}`} width={s.img.width} height={s.img.height} fetchpriority="high" decoding="async" />
              ) : (
                <img class="stage-engine" data-engine={s.p.id} data-src={s.img.src} data-srcset={s.img.srcset} sizes={STAGE_SIZES} alt={`${s.p.model} — ${t('product_image_alt')}`} width={s.img.width} height={s.img.height} decoding="async" />
              )
            )}
          </div>

          <div class="stage-rpm">
            <span class="stage-rpm-label">{t('stage_rpm_label')}</span>
            <span class="stage-rpm-value"><bdi data-read="rpm">{rpmText(active.m.rpm)}</bdi> <small>{u('rpm')}</small></span>
          </div>
        </div>

        <dl class="stage-readout">
          <div>
            <dt>{t('short_power')}</dt>
            <dd><bdi><span data-count="kw">{num(active.m.kw)}</span> <small>{u('kW')}</small></bdi></dd>
          </div>
          <div>
            <dt>{t('short_thrust_100')}</dt>
            <dd><bdi><span data-count="thrust">{num(active.m.thrust100)}</span> <small>{u('kg')}</small></bdi></dd>
          </div>
          <div>
            <dt>{t('short_displacement')}</dt>
            <dd><bdi><span data-count="cc">{num(active.m.cc)}</span> <small>{u('cc')}</small></bdi></dd>
          </div>
          <div>
            <dt data-read="weight-label">{weightLabel(active.m)}</dt>
            <dd><bdi><span data-count="weight">{num(active.m.weight)}</span> <small>{u('kg')}</small></bdi></dd>
          </div>
        </dl>

        <!-- 型号切换按钮（需要 JS；没有 JS 时隐藏，展台固定展示旗舰型号） -->
        <div class="stage-tabs" role="group" aria-label={t('stage_tabs_label')}>
          {stage.map((s) => (
            <button
              type="button"
              class="stage-tab"
              aria-pressed={s === active ? 'true' : 'false'}
              data-tab={s.p.id}
              data-model={s.p.model}
              data-href={`/${lang}/products/${s.p.id}/`}
              data-cyl={s.p.cylinders === 4 ? t('filter_four') : t('filter_twin')}
              data-cool={s.p.cooling === 'water' ? t('filter_water') : t('filter_air')}
              data-kw={s.m.kw ?? ''}
              data-thrust={s.m.thrust100 ?? ''}
              data-cc={s.m.cc ?? ''}
              data-weight={s.m.weight ?? ''}
              data-weight-label={weightLabel(s.m)}
              data-rpm-text={rpmText(s.m.rpm)}
              data-arc-a={rpmArc(s.m.rpm).a}
              data-arc-b={rpmArc(s.m.rpm).b}
              aria-label={s.p.model}
            >
              <span>{shortModel(s.p)}</span>
              <i class="stage-tab-progress" aria-hidden="true"></i>
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 滚动卖点条 -->
  <Ticker />

  <!-- ======================================================
       3. 产品线
       ====================================================== -->
  <section class="section" id="lineup" aria-labelledby="lineup-title">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={t('home_lineup_eyebrow')} title={t('home_lineup_title')} desc={t('home_lineup_desc')} id="lineup-title" />
        <a class="btn btn--ghost head-row-cta" href={`/${lang}/products/`} data-reveal>
          {t('home_view_all')}
          <ArrowRight class="icon-dir" aria-hidden="true" />
        </a>
      </div>
      <div class="product-grid">
        {products.map((p, i) => <ProductCard product={p} lang={lang} i={i} />)}
      </div>
    </div>
  </section>

  <!-- ======================================================
       4. 全系性能对比图（数据全部来自 products.json）
       ====================================================== -->
  <section class="section section--alt section--line" id="performance" aria-labelledby="chart-title">
    <div class="container">
      <SectionHead eyebrow={t('chart_eyebrow')} title={t('chart_title')} desc={t('chart_desc')} id="chart-title" />

      <div class="lc card" data-chart data-metric="thrust" data-reveal>
        <div class="lc-toolbar">
          <div class="seg" role="group" aria-label={t('chart_metric_label')}>
            <button type="button" data-metric-btn="thrust" aria-pressed="true">{t('chart_metric_thrust')}</button>
            <button type="button" data-metric-btn="power" aria-pressed="false">{t('chart_metric_power')}</button>
            <button type="button" data-metric-btn="mtow" aria-pressed="false">{t('chart_metric_mtow')}</button>
          </div>
          <ul class="lc-legend" data-for="thrust">
            <li><span class="sw sw--a" aria-hidden="true"></span>{t('chart_legend_100')}</li>
            <li><span class="sw sw--b" aria-hidden="true"></span>{t('chart_legend_1800')}</li>
          </ul>
        </div>

        <div class="lc-plot">
          <div class="lc-axes" aria-hidden="true">
            {(Object.keys(axes) as (keyof typeof axes)[]).map((k) => (
              <div class="lc-axis" data-for={k}>
                {axes[k].map((v) => (
                  <span style={`--x:${v / axisMax(k)}`}><i>{formatNumber(v, lang)}</i></span>
                ))}
                <b class="lc-axis-unit">{axisUnit[k]}</b>
              </div>
            ))}
          </div>

          <ol class="lc-rows">
            {chartRows.map((r) => (
              <li
                class="lc-row"
                style={`--thrust-a:${r.thrustA.toFixed(4)};--thrust-b:${r.thrustB.toFixed(4)};--power:${r.power.toFixed(4)};--mtow:${r.mtow.toFixed(4)}`}
              >
                <a class="lc-label" href={`/${lang}/products/${r.p.id}/`}>{r.p.model}</a>
                <div class="lc-track">
                  <span class="lc-bar lc-bar--a"></span>
                  <span class="lc-bar lc-bar--b"></span>
                  <span class="lc-val">
                    <bdi data-for="thrust">{num(r.m.thrust100)} {u('kg')}</bdi>
                    <bdi data-for="power">{num(r.m.kw)} {u('kW')}</bdi>
                    {r.m.mtow !== null ? <bdi data-for="mtow">{num(r.m.mtow)} {u('kg')}</bdi> : <span class="lc-na" data-for="mtow">{t('chart_no_data')}</span>}
                  </span>
                  <!-- 悬停/聚焦时的提示框：同时显示两个海拔的推力 -->
                  <span class="lc-tip" aria-hidden="true">
                    <strong>{r.p.model}</strong>
                    <span data-for="thrust"><i class="sw sw--a"></i>{t('chart_legend_100')} <b><bdi>{num(r.m.thrust100)} {u('kg')}</bdi></b></span>
                    <span data-for="thrust"><i class="sw sw--b"></i>{t('chart_legend_1800')} <b><bdi>{num(r.m.thrust1800)} {u('kg')}</bdi></b></span>
                    <span data-for="power">{t('chart_metric_power')} <b><bdi>{num(r.m.kw)} {u('kW')}</bdi></b></span>
                    <span data-for="mtow">{t('chart_metric_mtow')} <b>{r.m.mtow !== null ? <bdi>{num(r.m.mtow)} {u('kg')}</bdi> : t('chart_no_data')}</b></span>
                  </span>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- 表格视图：图表的“无障碍孪生”，读屏用户和想看精确数字的人都能用 -->
        <details class="lc-table">
          <summary>{t('chart_show_table')}</summary>
          <div class="table-scroll">
            <table>
              <caption class="visually-hidden">{t('chart_table_caption')}</caption>
              <thead>
                <tr>
                  <th scope="col">{t('compare_model')}</th>
                  <th scope="col">{t('chart_metric_thrust')} · {t('chart_legend_100')}</th>
                  <th scope="col">{t('chart_metric_thrust')} · {t('chart_legend_1800')}</th>
                  <th scope="col">{t('chart_metric_power')}</th>
                  <th scope="col">{t('chart_metric_mtow')}</th>
                </tr>
              </thead>
              <tbody>
                {chartRows.map((r) => (
                  <tr>
                    <th scope="row">{r.p.model}</th>
                    <td><bdi>{num(r.m.thrust100)} {u('kg')}</bdi></td>
                    <td><bdi>{num(r.m.thrust1800)} {u('kg')}</bdi></td>
                    <td><bdi>{num(r.m.kw)} {u('kW')}</bdi></td>
                    <td>{r.m.mtow !== null ? <bdi>{num(r.m.mtow)} {u('kg')}</bdi> : t('chart_no_data')}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- ======================================================
       5. 为什么选择我们（6 项，全部来自真实参数）
       ====================================================== -->
  <section class="section section--line" id="why" aria-labelledby="why-title">
    <div class="container">
      <SectionHead eyebrow={t('home_why_eyebrow')} title={t('home_why_title')} desc={t('home_why_desc')} id="why-title" />
      <div class="feature-grid feature-grid--3">
        {strengths.map((s, i) => {
          const Icon = s.icon;
          return (
            <article class="card feature" data-spotlight data-reveal style={`--i:${i % 3}`}>
              <span class="icon-tile"><Icon aria-hidden="true" /></span>
              <h3>{t(s.title)}</h3>
              <p>{t(s.text)}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ======================================================
       6. 关于我们（客户提供的真实简介；2026-10-23 按用户要求改为“十年无人机发动机”）
       ====================================================== -->
  <section class="section section--alt section--line" id="about" aria-labelledby="about-title">
    <div class="container about">
      <div class="about-copy" data-reveal>
        <p class="eyebrow">{t('home_about_title')}</p>
        <h2 class="section-title text-steel" id="about-title">{t('home_about_heading')}</h2>
