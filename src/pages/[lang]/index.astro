<script>
  // ============================================================
  // 首页交互：发动机展台切换 / 性能图指标切换 / 大数字滚动
  // ============================================================
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 数字滚动动画：从当前值滚到目标值
  function animateNumber(el: HTMLElement, to: number, locale: string, duration = 700) {
    const decimals = (String(to).split('.')[1] ?? '').length;
    const fmt = new Intl.NumberFormat(locale, { minimumFractionDigits: decimals, maximumFractionDigits: decimals, useGrouping: false });
    const from = Number(el.dataset.value ?? to);
    el.dataset.value = String(to);
    if (reduceMotion || from === to) {
      el.textContent = fmt.format(to);
      return;
    }
    const t0 = performance.now();
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt.format(from + (to - from) * eased);
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // ---------- 1) 发动机展台 ----------
  const stageEl = document.querySelector<HTMLElement>('[data-stage]');
  if (stageEl) {
    const locale = stageEl.dataset.locale ?? 'en-US';
    const tabs = Array.from(stageEl.querySelectorAll<HTMLButtonElement>('.stage-tab'));
    const engines = Array.from(stageEl.querySelectorAll<HTMLImageElement>('.stage-engine'));
    const range = stageEl.querySelector<SVGCircleElement>('[data-gauge-range]');
    const marker = stageEl.querySelector<SVGGElement>('[data-gauge-marker]');
    const read = (name: string) => stageEl.querySelector<HTMLElement>(`[data-read="${name}"]`);
    const counters = Array.from(stageEl.querySelectorAll<HTMLElement>('[data-count]'));
    counters.forEach((el) => {
      const active = tabs.find((b) => b.getAttribute('aria-pressed') === 'true');
      el.dataset.value = active?.dataset[el.dataset.count as string] ?? '0';
    });

    const loadImg = (img: HTMLImageElement) => {
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src ?? '';
    };
    // 页面加载完后，空闲时再预加载其它型号的图片（不影响首屏速度）
    const preload = () =>
      engines.forEach((img) => {
        if (img.dataset.src && !img.src) loadImg(img);
      });
    if ('requestIdleCallback' in window) requestIdleCallback(preload, { timeout: 3000 });
    else setTimeout(preload, 1500);

    let index = Math.max(0, tabs.findIndex((b) => b.getAttribute('aria-pressed') === 'true'));
    let userPicked = false;
    let inView = true;
    // 自动轮播：当前按钮下的进度条（CSS 动画，5.5 秒）走完，就切到下一个型号。
    // 鼠标悬停 / 键盘聚焦时 CSS 会暂停进度条，切换也就自然跟着暂停，两者永远同步。
    const canCycle = () => !userPicked && !reduceMotion && inView;
    const restartProgress = () => {
      stageEl.classList.remove('is-cycling');
      void stageEl.offsetWidth; // 强制重排，让进度条动画从头开始
      if (canCycle()) stageEl.classList.add('is-cycling');
    };

    const show = (i: number) => {
      index = (i + tabs.length) % tabs.length;
      const tab = tabs[index];
      const d = tab.dataset;
      tabs.forEach((b) => b.setAttribute('aria-pressed', String(b === tab)));
      engines.forEach((img) => {
        const on = img.dataset.engine === d.tab;
        if (on && img.dataset.src && !img.src) loadImg(img);
        img.classList.toggle('is-active', on);
      });
      const set = (name: string, v?: string) => {
        const el = read(name);
        if (el && v !== undefined) el.textContent = v;
      };
      set('model', d.model);
      set('cyl', d.cyl);
      set('cool', d.cool);
      set('rpm', d.rpmText);
      set('weight-label', d.weightLabel);
      const link = read('href') as HTMLAnchorElement | null;
      if (link && d.href) link.href = d.href;
      counters.forEach((el) => {
        const v = Number(d[el.dataset.count as string]);
        if (!Number.isNaN(v)) animateNumber(el, v, locale);
      });
      const a = Number(d.arcA);
      const b = Number(d.arcB);
      if (range) {
        // 用 dashoffset 定位起点（若用长度为 0 的虚线段，圆头线帽会在起点多画出一个小圆点）
        range.style.strokeDasharray = `${b - a} 360`;
        range.style.strokeDashoffset = String(-a);
      }
      if (marker) marker.style.transform = `rotate(${135 + b}deg)`;
      restartProgress();
    };

    // 进度条走完 → 下一个型号
    stageEl.addEventListener('animationend', (e) => {
      if ((e.target as Element).classList.contains('stage-tab-progress') && canCycle()) show(index + 1);
    });

    // 用户亲自选了型号，就停止自动轮播
    const stopCycling = () => {
      userPicked = true;
      stageEl.classList.remove('is-cycling');
    };
    tabs.forEach((tab, i) =>
      tab.addEventListener('click', () => {
        stopCycling();
        show(i);
      }),
    );
    // 左右方向键切换型号（RTL 下方向相反）
    stageEl.querySelector('.stage-tabs')?.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
      const rtl = document.documentElement.dir === 'rtl';
      const forward = (ev.key === 'ArrowRight') !== rtl;
      stopCycling();
      show(index + (forward ? 1 : -1));
      tabs[index].focus();
      ev.preventDefault();
    });
    // 展台滚出屏幕时暂停轮播（省电，也避免用户回来时“跳”了很多次）；回到屏幕内从当前型号重新计时
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        restartProgress();
      }).observe(stageEl);
    } else {
      restartProgress();
    }
  }

  // ---------- 2) 性能对比图：切换指标 ----------
  const chart = document.querySelector<HTMLElement>('[data-chart]');
  chart?.querySelectorAll<HTMLButtonElement>('[data-metric-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      chart.dataset.metric = btn.dataset.metricBtn;
      chart.querySelectorAll('[data-metric-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    });
  });

  // ---------- 3) 关于我们：大数字从 0 滚动到目标值 ----------
  const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
  if (countEls.length && 'IntersectionObserver' in window && !reduceMotion) {
    const statLocale: Record<string, string> = { ru: 'ru-RU', en: 'en-US', zh: 'zh-CN', fa: 'fa-IR' };
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const to = Number(el.dataset.countup);
          const fmt = new Intl.NumberFormat(statLocale[el.dataset.locale ?? 'en'] ?? 'en-US');
          const t0 = performance.now();
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / 1600);
            const eased = 1 - Math.pow(1 - p, 4);
            el.textContent = fmt.format(Math.round(to * eased));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        }
      },
      { threshold: 0.6 },
    );
    countEls.forEach((el) => io.observe(el));
  }
</script>

