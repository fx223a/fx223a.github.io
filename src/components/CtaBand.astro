---
// ============================================================
// 询价 CTA 横幅（首页 / 产品页 / 详情页底部共用）
// WhatsApp 主按钮 + Telegram + 询价表单入口 + 电脑端显示 WhatsApp 二维码（手机扫码即聊）
// 价格不上网站（客户要求）：这里只引导到私聊。
// ============================================================
import Lock from '@lucide/astro/icons/lock';
import BrandIcon from './BrandIcon.astro';
import QrCode from './QrCode.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { CONTACT } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  /** 自定义 WhatsApp 链接（详情页用：预填“我想咨询 YT-550CC”） */
  whatsappHref?: string;
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('cta_title'), text = t('home_contact_text'), whatsappHref = CONTACT.whatsappLink } = Astro.props;
---
<section class="section section--cta" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-band" data-reveal>
      <div>
        <p class="eyebrow">{t('cta_eyebrow')}</p>
        <h2 id="cta-title" class="text-steel">{title}</h2>
        <p>{text}</p>
        <div class="cta-actions">
          <a class="btn btn--primary btn--lg" href={whatsappHref} target="_blank" rel="noopener">
            <BrandIcon name="whatsapp" />
            {t('cta_chat_whatsapp')}
          </a>
          <a class="btn btn--ghost btn--lg" href={CONTACT.telegramLink} target="_blank" rel="noopener">
            <BrandIcon name="telegram" />
            Telegram
          </a>
          <a class="btn btn--ghost btn--lg" href={`/${lang}/inquiry/`}>{t('nav_inquiry')}</a>
        </div>
        <p class="cta-note">
          <Lock aria-hidden="true" />
          {t('cta_note')}
        </p>
      </div>
      <div class="qr-card">
        <QrCode value={CONTACT.whatsappLink} label={t('cta_scan')} />
        <span>{t('cta_scan')}</span>
      </div>
    </div>
  </div>
</section>
