---
// ============================================================
// 二维码（构建时生成 SVG，页面上零 JavaScript）
// 用途：电脑上浏览网站的客户，用手机一扫就能打开 WhatsApp / Telegram 聊天。
// 用法：<QrCode value="https://wa.me/..." label="WhatsApp QR" />
// ============================================================
import QRCode from 'qrcode';

interface Props {
  value: string;
  label: string;
  class?: string;
}
const { value, label, class: className } = Astro.props;

const svg = await QRCode.toString(value, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0b0c0f', light: '#ffffff' },
});
---
<div class:list={['qr', className]} role="img" aria-label={label} set:html={svg} />

<style>
  .qr :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
