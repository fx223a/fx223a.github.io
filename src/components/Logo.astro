---
// ============================================================
// Logo：螺旋桨图形标 + “UAV DRONE / ENGINE”文字标
// 说明：客户暂未提供 Logo（CONTENT-TODO A2），这是一个简洁的临时品牌标识。
//       客户提供正式 Logo 后，替换本组件里的 <svg> 即可，全站自动更新。
//       浏览器标签图标 public/favicon.svg 使用同一个图形。
// ============================================================
interface Props {
  /** 只显示图形标，不显示文字 */
  markOnly?: boolean;
  /** 同一页面出现多个 Logo 时，用不同 id 避免渐变定义冲突 */
  id?: string;
}
const { markOnly = false, id = 'logo' } = Astro.props;
---
<svg class="logo-mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#20242b" />
      <stop offset="1" stop-color="#0c0e11" />
    </linearGradient>
    <linearGradient id={`${id}-acc`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#e3171c" />
      <stop offset="0.55" stop-color="#ff4b3a" />
      <stop offset="1" stop-color="#ff9a4a" />
    </linearGradient>
  </defs>
  <rect x="0.5" y="0.5" width="39" height="39" rx="11" fill={`url(#${id}-bg)`} stroke="rgba(255,255,255,0.14)" />
  <circle cx="20" cy="20" r="14" fill="none" stroke={`url(#${id}-acc)`} stroke-width="1" stroke-dasharray="1.5 2.6" opacity="0.55" />
  <g fill={`url(#${id}-acc)`}>
    <path transform="rotate(38 20 20)" d="M20 20C18.3 16.4 18.5 10.6 19.4 6.7c.3-1.1 1.5-1.2 1.8-.1 1.4 4.1 1.2 9.8-1.2 13.4Z" />
    <path transform="rotate(218 20 20)" d="M20 20C18.3 16.4 18.5 10.6 19.4 6.7c.3-1.1 1.5-1.2 1.8-.1 1.4 4.1 1.2 9.8-1.2 13.4Z" />
  </g>
  <circle cx="20" cy="20" r="3" fill="#f4f5f7" />
  <circle cx="20" cy="20" r="1.1" fill="#ff4b3a" />
</svg>
{!markOnly && (
  <span class="logo-text">
    <span class="logo-name">UAV DRONE</span>
    <span class="logo-sub">ENGINE</span>
  </span>
)}
