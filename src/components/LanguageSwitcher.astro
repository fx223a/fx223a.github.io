---
// ============================================================
// 语言切换器（下拉菜单）
// 点击后跳到“同一个页面”的对应语言版本：在 /en/products/ 点 Русский → /ru/products/。
// 用原生 <details> 实现：不开 JavaScript 也能展开；site.ts 只负责“点外面自动收起”。
// ============================================================
import Globe from '@lucide/astro/icons/globe';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import { locales, localeNames } from '../i18n/config';
import { getLangFromUrl, useTranslations, localizedPath } from '../i18n/utils';

const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
---
<details class="lang-menu" data-dropdown>
  <summary aria-label={`${t('language_label')}: ${localeNames[currentLang]}`}>
    <Globe aria-hidden="true" />
    <span>{currentLang}</span>
    <ChevronDown aria-hidden="true" />
  </summary>
  <!-- aria-current 标记当前语言；lang 属性让读屏软件用对应语言朗读语言名 -->
  <nav class="lang-list" aria-label={t('language_label')}>
    {locales.map((loc) => (
      <a
        href={localizedPath(Astro.url, loc)}
        hreflang={loc}
        lang={loc}
        aria-current={loc === currentLang ? 'true' : undefined}
      >
        <span>{localeNames[loc]}</span>
        <span class="lang-code">{loc}</span>
      </a>
    ))}
  </nav>
</details>
